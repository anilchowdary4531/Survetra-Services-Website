# Backend Environment Configuration Example
# Copy to .env for backend configuration: cp .env.example .env

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=survetra_db
DB_USER=survetra_user
DB_PASSWORD=replace_with_database_password
JWT_SECRET=replace_with_64_character_hex_secret_key_for_jwt_signing
JWT_EXPIRATION_MS=86400000
ADMIN_DEFAULT_EMAIL=admin@survetra.com
ADMIN_DEFAULT_PASSWORD=replace_with_admin_password
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://survetra.com
AWS_REGION=us-east-1
AWS_S3_BUCKET=survetra-production-media
AWS_ACCESS_KEY_ID=replace_with_aws_access_key
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_key
