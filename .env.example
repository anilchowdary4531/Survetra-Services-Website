# ==============================================================================
# Survetra Services Corporate Platform — Environment Variables Example
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=survetra_db
POSTGRES_USER=survetra_user
POSTGRES_PASSWORD=replace_with_strong_production_database_password

# Backend Core Configuration (Spring Boot 3)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_HOST=postgres
DB_PORT=5432

# Security & Authentication (JWT HMAC-SHA256)
# Generate a cryptographically secure 64-character hex key: openssl rand -hex 32
JWT_SECRET=replace_with_64_character_hex_secret_key_for_production_jwt_signing
JWT_EXPIRATION_MS=86400000

# Administrator Provisioning
ADMIN_DEFAULT_EMAIL=admin@survetra.com
ADMIN_DEFAULT_PASSWORD=replace_with_strong_admin_password_min_14_chars

# Network & CORS Directives
CORS_ALLOWED_ORIGINS=https://survetra.com,https://www.survetra.com

# Cloud Storage (AWS S3 or Compatible Object Storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET=survetra-production-media
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key

# Frontend Configuration (Next.js 14)
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://survetra.com/api/v1
NEXT_PUBLIC_SITE_URL=https://survetra.com

